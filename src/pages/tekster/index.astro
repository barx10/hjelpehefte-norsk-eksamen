---
import Layout from '../../layouts/Layout.astro';
import { hentBesvarelser, typeTittel } from '../../lib/innhold';
import { url } from '../../lib/url';

const alle = await hentBesvarelser();
const rekkefolge = ['diktanalyse', 'novelleanalyse', 'retorisk-analyse', 'reklameanalyse', 'fagartikkel', 'reflekterende-tekst', 'droftende-tekst'] as const;
const grupper = rekkefolge
  .map((type) => ({ type, tekster: alle.filter((b) => b.data.type === type) }))
  .filter((g) => g.tekster.length > 0);
---
<Layout tittel="Modelltekster" beskrivelse="Gode eksempler på analyser og andre tekster, med merknader til hvert avsnitt.">
  <h1>Modelltekster</h1>
  <p>Her kan du lese gode eksempler på tekster du skal skrive selv. Hvert avsnitt har en merknad som viser hva det gjør. Les først, og slå så på merknadene. Mange av tekstene finnes i en forenklet versjon som passer for 10. trinn, og i originalversjonen fra videregående.</p>
  {grupper.length === 0 && <p>Det er ingen godkjente tekster ennå.</p>}
  {grupper.map((g) => (
    <section class="tekst-gruppe" aria-labelledby={`g-${g.type}`}>
      <h2 id={`g-${g.type}`}>{typeTittel[g.type]}</h2>
      <ul class="liste-kapitler">
        {g.tekster.map((t) => (
          <li>
            <a class="tekstkort" href={url(`tekster/${t.id}/`)}>
              <strong>{t.data.tittel}</strong>
              <span class="liten">{t.data.nivaa}{t.data.forfatter ? `. ${t.data.forfatter}` : ''}</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a href={url(`ovelser/${g.type}/`)}>Øv på {typeTittel[g.type].toLowerCase()}</a> · <a href={url(`hefte/${g.type}/`)}>Les kapittelet i heftet</a></p>
    </section>
  ))}
  <div class="merknad">
    <p>Tekstene er hentet fra NDLA og bruker lisensen CC BY-SA 4.0. Navn på forfatter, lisens og kilde står under hver tekst.</p>
  </div>
</Layout>

---
import Layout from '../../../layouts/Layout.astro';
import Ovelsesrunner from '../../../components/Ovelsesrunner.astro';
import { hentBesvarelser, hentKapitler, hentOvelser, kapittelNavn, tilKlient } from '../../../lib/innhold';
import { nurl } from '../../../lib/url';
import { NIVAAER } from '../../../lib/nivaa';

export async function getStaticPaths() {
  const alle = await Promise.all(
    NIVAAER.map(async (nivaa) => {
      const kapitler = await hentKapitler(nivaa);
      const ovelser = await hentOvelser(nivaa);
      const tekster = new Map((await hentBesvarelser(nivaa)).map((b) => [b.id, b]));
      const tittelPerId = new Map(kapitler.map((k) => [k.id, kapittelNavn(k)]));
      const klient = (liste: typeof ovelser) => liste.map((o) => tilKlient(o, tittelPerId.get(o.data.kapittel.id) ?? '', tekster));

      const sider = kapitler
        .map((k) => ({ k, liste: ovelser.filter((o) => o.data.kapittel.id === k.id) }))
        .filter(({ liste }) => liste.length > 0)
        .map(({ k, liste }) => ({
          params: { nivaa: nivaa.id, tema: k.id },
          props: { nivaa, tittel: kapittelNavn(k), ingress: k.data.ingress, ovelser: klient(liste), kapittelId: k.id },
        }));
      if (ovelser.length === 0) return sider;
      return [
        { params: { nivaa: nivaa.id, tema: 'alle' }, props: { nivaa, tittel: 'Alle temaer', ingress: 'Blandede øvelser fra hele heftet.', ovelser: klient(ovelser), kapittelId: null } },
        ...sider,
      ];
    }),
  );
  return alle.flat();
}

const { nivaa, tittel, ingress, ovelser, kapittelId } = Astro.props;
---
<Layout tittel={`Øv: ${tittel}`} nivaa={nivaa}>
  <nav aria-label="Brødsmulesti" class="tilbake"><a href={nurl(nivaa, '')}>Tilbake til kapitlene</a></nav>
  <h1>{tittel}</h1>
  {ingress && <p>{ingress}</p>}
  <Ovelsesrunner ovelser={ovelser} tittel={tittel} />
  <p class="tastehint">Eksempeltekstene i øvelsene er laget for øving.
    {kapittelId && <> <a href={nurl(nivaa, `hefte/${kapittelId}/`)}>Les kapittelet i heftet</a>.</>}
  </p>
</Layout>

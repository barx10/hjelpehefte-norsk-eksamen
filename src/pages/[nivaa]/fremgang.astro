---
import Layout from '../../layouts/Layout.astro';
import { hentKapitler, hentOvelser, nivaaStier, tilJson } from '../../lib/innhold';
import { NIVAAER } from '../../lib/nivaa';
import { nurl } from '../../lib/url';

export const getStaticPaths = nivaaStier;
const { nivaa } = Astro.props;

const kapitler = await hentKapitler(nivaa);
const ovelser = await hentOvelser(nivaa);
const temaer = kapitler
  .map((k) => ({ tittel: k.data.tittel, nummer: k.data.nummer, ider: ovelser.filter((o) => o.data.kapittel.id === k.id).map((o) => o.id) }))
  .filter((t) => t.ider.length > 0);
---
<Layout tittel="Min fremgang" beskrivelse="Se, flytt og nullstill fremgangen din." nivaa={nivaa}>
  <h1>Min fremgang</h1>
  <p>Fremgangen lagres bare i nettleseren på denne enheten. Vil du bytte mellom mobil og PC, kan du flytte den her. Denne siden gjelder {nivaa.navn.toLowerCase()}. Hvert nivå har sin egen fremgang.</p>

  <div class="stat" id="stat" aria-live="polite"></div>
  <h2>Per tema</h2>
  <ul class="mal-liste" id="per-tema"></ul>

  <h2>Flytt fremgangen</h2>
  <ol>
    <li>Trykk «Del lenke» på enheten der fremgangen ligger.</li>
    <li>Send lenken til deg selv, for eksempel på melding eller e-post.</li>
    <li>Åpne lenken på den andre enheten og svar ja når siden spør.</li>
  </ol>
  <div class="knapp-rad">
    <button class="knapp" type="button" id="del-lenke">Del lenke</button>
  </div>

  <h3>Sikkerhetskopi</h3>
  <p>Du kan også lagre fremgangen som en fil og hente den inn igjen senere. Du trenger ikke å åpne filen.</p>
  <div class="knapp-rad">
    <button class="knapp sekundar" type="button" id="last-ned">Lagre sikkerhetskopi</button>
    <label class="knapp sekundar" for="fil">Hent fra sikkerhetskopi</label>
    <input type="file" id="fil" accept=".txt,.json,text/plain,application/json" hidden />
  </div>

  <details class="modell">
    <summary>Bruk kode i stedet</summary>
    <label for="eksport"><strong>Din kode.</strong> Kopier den og lim den inn på den andre enheten.</label>
    <textarea id="eksport" readonly rows="3"></textarea>
    <div class="knapp-rad">
      <button class="knapp sekundar" type="button" id="kopier">Kopier kode</button>
    </div>
    <label for="import"><strong>Lim inn kode.</strong> Den erstatter fremgangen på denne enheten.</label>
    <textarea id="import" rows="3"></textarea>
    <div class="knapp-rad">
      <button class="knapp sekundar" type="button" id="importer">Hent fremgang</button>
    </div>
  </details>
  <p class="melding" id="melding" role="status"></p>

  <h2>Nullstill</h2>
  <p>Sletter all fremgang for {nivaa.navn.toLowerCase()} på denne enheten.</p>
  <div class="knapp-rad"><button class="knapp sekundar" type="button" id="nullstill">Nullstill fremgang</button></div>

  <script type="application/json" id="temaer" set:html={tilJson(temaer)} />
  <script type="application/json" id="nivaaer" set:html={tilJson(NIVAAER.map((n) => ({ id: n.id, navn: n.navn, side: nurl(n, 'fremgang/') })))} />
</Layout>

<script>
  import { les, lagre, lagKode, lesKode, nullstill, antallMestret, tom } from '../../lib/fremgang';

  type Tema = { tittel: string; nummer: string; ider: string[] };
  const temaer: Tema[] = JSON.parse(document.getElementById('temaer')!.textContent ?? '[]');
  const alleIder = temaer.flatMap((t) => t.ider);
  const nivaaer: { id: string; navn: string; side: string }[] = JSON.parse(document.getElementById('nivaaer')!.textContent ?? '[]');
  const nivaa = document.documentElement.dataset.nivaa ?? '';
  const denneSiden = () => location.href.split('#')[0]!;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const melding = (tekst: string) => { $('melding').textContent = tekst; };

  function tegn() {
    const f = les();
    const poster = alleIder.map((id) => f[id]).filter((p) => p !== undefined);
    const svar = poster.reduce((s, p) => s + p.riktig + p.feil, 0);
    const riktig = poster.reduce((s, p) => s + p.riktig, 0);
    const stat = $('stat');
    stat.replaceChildren(
      ...[
        [`${antallMestret(f, alleIder)} av ${alleIder.length}`, 'øvelser mestret'],
        [String(poster.length), 'øvelser prøvd'],
        [svar > 0 ? `${Math.round((riktig / svar) * 100)} %` : '–', 'riktige svar'],
      ].map(([tall, tekst]) => {
        const d = document.createElement('div');
        const s = document.createElement('strong');
        s.textContent = tall!;
        d.append(s, tekst!);
        return d;
      }),
    );

    $('per-tema').replaceChildren(
      ...temaer.map((t) => {
        const li = document.createElement('li');
        li.className = 'mal';
        const m = antallMestret(f, t.ider);
        li.textContent = `${t.nummer ? t.nummer + ' ' : ''}${t.tittel}: ${m} av ${t.ider.length} mestret`;
        return li;
      }),
    );
    void lagKode(f, nivaa).then((kode) => { $<HTMLTextAreaElement>('eksport').value = kode; });
  }

  async function kopierTekst(tekst: string): Promise<boolean> {
    try { await navigator.clipboard.writeText(tekst); return true; } catch { return false; }
  }

  $('del-lenke').addEventListener('click', async () => {
    const lenke = `${denneSiden()}#hent=${await lagKode(les(), nivaa)}`;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try {
        await navigator.share({ title: 'Min fremgang i norsk', text: 'Åpne lenken på den andre enheten for å hente fremgangen.', url: lenke });
        return melding('Åpne lenken på den andre enheten og svar ja når siden spør.');
      } catch (e) {
        if ((e as Error).name === 'AbortError') return;
      }
    }
    if (await kopierTekst(lenke)) return melding('Lenken er kopiert. Send den til deg selv og åpne den på den andre enheten.');
    ($('eksport').closest('details') as HTMLDetailsElement).open = true;
    $<HTMLTextAreaElement>('eksport').value = lenke;
    $<HTMLTextAreaElement>('eksport').select();
    melding('Kunne ikke kopiere automatisk. Lenken er markert i feltet under, så du kan kopiere den selv.');
  });

  $('kopier').addEventListener('click', async () => {
    if (await kopierTekst($<HTMLTextAreaElement>('eksport').value)) return melding('Koden er kopiert.');
    $<HTMLTextAreaElement>('eksport').select();
    melding('Kunne ikke kopiere automatisk. Koden er markert, så du kan kopiere den selv.');
  });

  $('last-ned').addEventListener('click', async () => {
    const blob = new Blob([await lagKode(les(), nivaa)], { type: 'text/plain;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `norsk-fremgang-${nivaa || 'alle'}.txt`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    melding('Sikkerhetskopien er lagret i nedlastingene dine.');
  });

  async function bruk(tekst: string, fraLenke = false) {
    const lest = await lesKode(tekst);
    if (!lest) {
      return melding(fraLenke
        ? 'Lenken virker ikke. Sjekk at du har fått med hele lenken.'
        : 'Koden er ikke gyldig. Sjekk at du har fått med alt.');
    }
    if (lest.nivaa && lest.nivaa !== nivaa) {
      const riktig = nivaaer.find((n) => n.id === lest.nivaa);
      const m = $('melding');
      m.textContent = `Denne fremgangen gjelder ${riktig?.navn.toLowerCase() ?? 'et annet nivå'}, ikke denne siden. `;
      if (riktig) {
        const a = document.createElement('a');
        a.href = `${riktig.side}#hent=${tekst.trim().match(/NORSK\.[^\s#&]+/)?.[0] ?? ''}`;
        a.textContent = `Gå til ${riktig.navn.toLowerCase()} for å hente den.`;
        m.append(a);
      }
      return;
    }
    const antall = Object.keys(lest.fremgang).length;
    const sporsmal = fraLenke
      ? `Vil du hente fremgangen fra lenken (${antall} øvelser)?${Object.keys(les()).length > 0 ? ' Den erstatter fremgangen på denne enheten.' : ''}`
      : 'Dette erstatter fremgangen på denne enheten. Vil du fortsette?';
    if ((fraLenke || Object.keys(les()).length > 0) && !confirm(sporsmal)) return;
    if (!lagre(lest.fremgang)) return melding('Nettleseren din lar ikke siden lagre fremgang.');
    tegn();
    melding(`Fremgangen er hentet (${antall} øvelser).`);
  }

  $('importer').addEventListener('click', () => bruk($<HTMLTextAreaElement>('import').value));
  $<HTMLInputElement>('fil').addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const fil = input.files?.[0];
    input.value = '';
    if (fil) await bruk(await fil.text());
  });
  $('nullstill').addEventListener('click', () => {
    if (!confirm('Vil du slette all fremgang på denne enheten?')) return;
    nullstill();
    lagre(tom());
    tegn();
    melding('Fremgangen er nullstilt.');
  });

  tegn();

  if (location.hash.startsWith('#hent=')) {
    const kode = decodeURIComponent(location.hash.slice('#hent='.length));
    history.replaceState(null, '', denneSiden());
    void bruk(kode, true);
  }
</script>

---
import Illustrasjon from '../../../components/Illustrasjon.astro';
import Layout from '../../../layouts/Layout.astro';
import { hentEksamen, nivaaStier } from '../../../lib/innhold';
import { nurl } from '../../../lib/url';

export const getStaticPaths = nivaaStier;
const { nivaa } = Astro.props;

const pakker = await hentEksamen(nivaa);
---
<Layout tittel="Eksamenstrening" beskrivelse="Tren på hele eller deler av eksamen med tidtaker, vedlegg og tilbakemelding." nivaa={nivaa}>
  <div class="sidehode">
    <div>
      <h1>Eksamenstrening</h1>
      <p>Skriv en hel eller en del av en eksamen med tidtaker. Du får vedlegg og oppgaver, og en automatisk sjekk av lengde og form når du leverer. Oppgavene er laget for øving og er ikke ekte eksamensoppgaver.</p>
    </div>
    <Illustrasjon motiv="eksamen" />
  </div>
  <ul class="liste-kapitler">
    {pakker.map((p) => (
      <li><a href={nurl(nivaa, `eksamen/${p.id}/`)}><span>{p.data.tittel}</span></a></li>
    ))}
  </ul>
  {pakker.length === 0 && <p>Det er ingen godkjente eksamenspakker ennå.</p>}
  <div class="merknad">
    <p><strong>Slik bruker du det.</strong> Du kan trene på én oppgave av gangen, eller på hele eksamen. Teksten din lagres bare i nettleseren din, og du kan laste den ned eller kopiere den for å vise den til læreren din.</p>
  </div>
</Layout>

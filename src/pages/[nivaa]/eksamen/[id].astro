---
import Layout from '../../../layouts/Layout.astro';
import Eksamensrunner from '../../../components/Eksamensrunner.astro';
import { hentEksamen, hentKapitler, kapittelNavn, visUtkast } from '../../../lib/innhold';
import { nurl } from '../../../lib/url';
import { NIVAAER } from '../../../lib/nivaa';
import { sjangerFor } from '../../../lib/tekstsjekk';

export async function getStaticPaths() {

  // Sjekklisten er hentet fra kapittel 8 i heftet.
  const sjekkliste = [
    { gruppe: 'Tekst og struktur', punkter: ['Har du svart på det oppgaven faktisk spør om?', 'Har du tittel, innledning, hoveddel og avslutning?', 'Starter hvert avsnitt med en temasetning?', 'Har du hoppet over en linje mellom hvert avsnitt?'] },
    { gruppe: 'Faglig kvalitet', punkter: ['Har du brukt minst tre fagbegreper der oppgaven ber om analyse?', 'Har du forklart hva virkemidlene gjør i teksten, ikke bare nevnt dem?', 'Har du brukt eksempler fra teksten (gjerne med sitat) som bevis?'] },
    { gruppe: 'Språk og form', punkter: ['Store bokstaver etter punktum?', 'Sammensatte ord skrevet som ett ord?', 'Kandidatnummer på plass, ikke navn?', 'Har du sjekket retteprogrammet på ord du er usikker på?', 'Oppfyller teksten lengdekravet som er oppgitt i oppgaven?'] },
  ];

  // Sjekkliste for vgs. Samme oppbygning som over, men med kilder og vedlegg.
  const sjekklisteVgs = [
    { gruppe: 'Svar på oppgaven', punkter: ['Har du gjort det instruksjonsordene ber om (gjør rede for, drøft, utforsk, tolk)?', 'Har du skrevet i riktig sjanger?', 'Har du brukt vedleggene aktivt, med eksempler og sitater?'] },
    { gruppe: 'Struktur og sammenheng', punkter: ['Har du tittel, innledning, hoveddel og avslutning (kortsvar: innledning, to eller tre avsnitt og kort avslutning)?', 'Starter hvert avsnitt med en tydelig påstand eller temasetning?', 'Henger avsnittene sammen med bindeord og overganger?'] },
    { gruppe: 'Språk og kilder', punkter: ['Har du brukt fagspråk presist?', 'Er rettskriving og tegnsetting kontrollert?', 'Har du oppgitt alle kilder, også vedleggene (forfatter og tittel, eller nettadresse og lesedato)?', 'Er lengden innenfor målet i oppgaven?'] },
  ];

  const sider = await Promise.all(NIVAAER.map(async (nivaa) => {
  const pakker = await hentEksamen(nivaa);
  const synlige = new Map((await hentKapitler(nivaa)).map((k) => [k.id, k]));
  const kapitler = Object.fromEntries([...synlige].map(([id, k]) => [id, { url: nurl(nivaa, `hefte/${id}/`), tittel: kapittelNavn(k) }]));
  return pakker.map((p) => {
    const d = p.data;
    const visKjennetegn = visUtkast || d.kjennetegnStatus === 'godkjent';
    const data = {
      id: p.id,
      tittel: d.tittel,
      beskrivelse: d.beskrivelse,
      oppsett: d.oppsett,
      vedlegg: d.vedlegg,
      oppgave1: d.oppgave1,
      oppgave2: {
        valg: d.oppgave2.valg.map((v) => ({
          id: v.id,
          tittel: v.tittel,
          tekst: v.tekst,
          vedlegg: [v.vedlegg ?? []].flat(),
          ord: v.ord,
          nokkelord: v.nokkelord,
          sitat: v.sitat,
          kjennetegn: visKjennetegn ? v.kjennetegn : [],
          malUrl: nurl(nivaa, `hefte/${v.mal.id}/`),
          malTittel: synlige.has(v.mal.id) ? kapittelNavn(synlige.get(v.mal.id)!) : v.mal.id,
          sjanger: sjangerFor(v.mal.id),
        })),
      },
      oppgave3: d.oppgave3 ? { ...d.oppgave3, kjennetegn: visKjennetegn ? d.oppgave3.kjennetegn : [] } : undefined,
      kjennetegnUtkast: d.kjennetegnStatus === 'utkast',
      sjekkliste: d.oppsett === 'vgs' ? sjekklisteVgs : sjekkliste,
      trinn: nivaa.kode === 'vg3' ? 'vg3 studieforberedende' : '10. trinn',
      kapitler,
    };
    return { params: { nivaa: nivaa.id, id: p.id }, props: { nivaa, tittel: d.tittel, data } };
  });
  }));
  return sider.flat();
}

const { nivaa, tittel, data } = Astro.props;
---
<Layout tittel={`Eksamenstrening: ${tittel}`} bredde="bred" nivaa={nivaa}>
  <nav aria-label="Brødsmulesti" class="tilbake"><a href={nurl(nivaa, 'eksamen/')}>Tilbake til eksamenstrening</a></nav>
  <h1>{tittel}</h1>
  <Eksamensrunner data={data} />
</Layout>

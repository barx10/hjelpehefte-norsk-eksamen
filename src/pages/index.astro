---
import Illustrasjon from '../components/Illustrasjon.astro';
import Layout from '../layouts/Layout.astro';
import { hentKapitler, hentOvelser } from '../lib/innhold';
import { NIVAAER, NIVAA_NOKKEL } from '../lib/nivaa';
import { nurl } from '../lib/url';

const valg = await Promise.all(
  NIVAAER.map(async (n) => ({
    n,
    kapitler: (await hentKapitler(n)).length,
    ovelser: (await hentOvelser(n)).length,
  })),
);
---
<Layout tittel="Hjelpehefte norsk eksamen" bredde="bred">
  <section class="hero sidehode">
    <div>
      <h1>Øv til skriftlig eksamen i norsk</h1>
      <p class="ingress">Velg nivå. Øvelser, hefte og kompetansemål tilpasses valget ditt. Du kan bytte nivå øverst på siden når du vil.</p>
    </div>
    <Illustrasjon motiv="skrivebord" />
  </section>
  <ul class="temaer nivaakort" id="nivaavalg" data-nokkel={NIVAA_NOKKEL}>
    {valg.map(({ n, kapitler, ovelser }) => (
      <li class="tema">
        <h2>{n.navn}</h2>
        <p>{n.beskrivelse}</p>
        <p class="meta">{ovelser > 0 ? `${kapitler} kapitler og ${ovelser} øvelser` : 'Innholdet er under arbeid'}</p>
        <div class="lenker"><a class="knapp" href={nurl(n)} data-nivaa={n.id}>Velg {n.navn.toLowerCase()}</a></div>
      </li>
    ))}
  </ul>
  <div class="merknad">
    <p><strong>Laget av Lærerliv.</strong> Heftet og øvelsene er gratis. Flere ressurser og tekster om skole finner du på <a href="https://laererliv.no">laererliv.no</a>.</p>
    <p><strong>Personvern.</strong> Valget og fremgangen din lagres bare i nettleseren. Siden har ingen innlogging og samler ikke inn data om deg.</p>
  </div>
</Layout>

<script>
  // Har eleven valgt nivå før, går vi rett dit. Med ?velg i adressen vises valget likevel.
  const liste = document.getElementById('nivaavalg');
  if (liste && !new URLSearchParams(location.search).has('velg')) {
    try {
      const valgt = localStorage.getItem(liste.dataset.nokkel ?? '');
      const lenke = valgt ? liste.querySelector<HTMLAnchorElement>(`a[data-nivaa="${CSS.escape(valgt)}"]`) : null;
      if (lenke) location.replace(lenke.href);
    } catch {
      /* ingen lagring */
    }
  }
</script>

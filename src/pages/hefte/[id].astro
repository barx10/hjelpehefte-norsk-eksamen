---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { hentBesvarelser, hentKapitler, hentOvelser } from '../../lib/innhold';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const kapitler = await hentKapitler();
  const ovelser = await hentOvelser();
  const tekster = await hentBesvarelser();
  return kapitler.map((k, i) => ({
    params: { id: k.id },
    props: {
      kapittel: k,
      forrige: kapitler[i - 1],
      neste: kapitler[i + 1],
      harOvelser: ovelser.some((o) => o.data.kapittel.id === k.id),
      tekster: tekster.filter((t) => t.data.type === k.id).map((t) => ({ id: t.id, tittel: t.data.tittel, nivaa: t.data.nivaa })),
    },
  }));
}

const { kapittel, forrige, neste, harOvelser, tekster } = Astro.props;
const { Content } = await render(kapittel);
---
<Layout tittel={kapittel.data.tittel}>
  <nav aria-label="Brødsmulesti"><a href={url('hefte/')}>Hefte</a></nav>
  <h1>{kapittel.data.nummer && `${kapittel.data.nummer} `}{kapittel.data.tittel}</h1>
  {harOvelser && (
    <div class="knapp-rad ikke-utskrift"><a class="knapp" href={url(`ovelser/${kapittel.id}/`)}>Øv på dette kapittelet</a></div>
  )}
  <div class="innhold"><Content /></div>
  {tekster.length > 0 && (
    <section class="ikke-utskrift" aria-labelledby="modelltekster">
      <h2 id="modelltekster">Les en modelltekst</h2>
      <ul class="liste-kapitler">
        {tekster.map((t) => (
          <li><a class="tekstkort" href={url(`tekster/${t.id}/`)}><strong>{t.tittel}</strong><span class="liten">{t.nivaa}</span></a></li>
        ))}
      </ul>
    </section>
  )}
  <nav class="kapittelnav" aria-label="Bla mellom kapitler">
    {forrige ? <a href={url(`hefte/${forrige.id}/`)}>← {forrige.data.tittel}</a> : <span></span>}
    {neste ? <a href={url(`hefte/${neste.id}/`)}>{neste.data.tittel} →</a> : <span></span>}
  </nav>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import { hentKapitler, hentOvelser } from '../../lib/innhold';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const kapitler = await hentKapitler();
  const ovelser = await hentOvelser();
  return kapitler.map((k, i) => ({
    params: { id: k.id },
    props: {
      kapittel: k,
      forrige: kapitler[i - 1],
      neste: kapitler[i + 1],
      harOvelser: ovelser.some((o) => o.data.kapittel.id === k.id),
    },
  }));
}

const { kapittel, forrige, neste, harOvelser } = Astro.props;
const { Content } = await render(kapittel);
---
<Layout tittel={kapittel.data.tittel}>
  <nav aria-label="Brødsmulesti"><a href={url('hefte/')}>Hefte</a></nav>
  <h1>{kapittel.data.nummer && `${kapittel.data.nummer} `}{kapittel.data.tittel}</h1>
  {harOvelser && (
    <div class="knapp-rad ikke-utskrift"><a class="knapp" href={url(`ovelser/${kapittel.id}/`)}>Øv på dette kapittelet</a></div>
  )}
  <div class="innhold"><Content /></div>
  <nav class="kapittelnav" aria-label="Bla mellom kapitler">
    {forrige ? <a href={url(`hefte/${forrige.id}/`)}>← {forrige.data.tittel}</a> : <span></span>}
    {neste ? <a href={url(`hefte/${neste.id}/`)}>{neste.data.tittel} →</a> : <span></span>}
  </nav>
</Layout>

---
// Skriftene ligger på eget domene, så siden sender ingen forespørsler til andre.
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@fontsource/archivo-narrow/latin-600.css';
import '../styles/global.css';
import { url, nurl } from '../lib/url';
import { visUtkast, hentBesvarelser, hentEksamen } from '../lib/innhold';
import Modaler from '../components/Modaler.astro';
import { NIVAAER, NIVAA_NOKKEL, type Nivaa } from '../lib/nivaa';

interface Props {
  tittel: string;
  // Tittel til deling (OpenGraph). Brukes når den skal avvike fra sidetittelen.
  ogTittel?: string;
  beskrivelse?: string;
  bredde?: 'smal' | 'bred';
  // Sider uten nivå (forsiden og feilsiden) viser bare nivåvalget i menyen.
  nivaa?: Nivaa;
}
const { tittel, ogTittel, beskrivelse = 'Lag ditt eget hefte, øv med flashcards, flervalg og modelltekster. Mengdetrening med over 1600 øvelser.', bredde = 'smal', nivaa } = Astro.props;
const naa = Astro.url.pathname;
const harTekster = nivaa ? (await hentBesvarelser(nivaa)).length > 0 : false;
const harEksamen = nivaa ? (await hentEksamen(nivaa)).length > 0 : false;
const under = (sti: string) => naa.startsWith(nurl(nivaa!, sti));
const lenker = nivaa
  ? [
      { href: nurl(nivaa), tekst: 'Øv', aktiv: naa === nurl(nivaa) || under('ovelser/') },
      ...(harTekster ? [{ href: nurl(nivaa, 'tekster/'), tekst: 'Modelltekster', aktiv: under('tekster/') }] : []),
      ...(harEksamen ? [{ href: nurl(nivaa, 'eksamen/'), tekst: 'Eksamenstrening', aktiv: under('eksamen/') }] : []),
      { href: nurl(nivaa, 'hefte/'), tekst: 'Hefte', aktiv: under('hefte/') },
      { href: nurl(nivaa, 'mal/'), tekst: 'Kompetansemål', aktiv: under('mal/') },
      { href: nurl(nivaa, 'fremgang/'), tekst: 'Min fremgang', aktiv: under('fremgang/') },
      { href: nurl(nivaa, 'sok/'), tekst: 'Søk', aktiv: under('sok/') },
    ]
  : [];
const fulltTittel = tittel.includes('Hjelpehefte norsk eksamen') ? tittel : `${tittel} | Hjelpehefte norsk eksamen`;
const delingstittel = ogTittel ?? fulltTittel;
const sideUrl = new URL(naa, Astro.site).href;
const ogBilde = new URL(url('og.png'), Astro.site).href;
---
<!doctype html>
<html lang="nb" data-nivaa={nivaa?.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beskrivelse} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={sideUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content="Hjelpehefte norsk eksamen" />
    <meta property="og:title" content={delingstittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={sideUrl} />
    <meta property="og:image" content={ogBilde} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eksamenstrening i norsk skriftlig. Lag ditt eget hefte, øv med flashcards, flervalg og modelltekster." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={delingstittel} />
    <meta name="twitter:description" content={beskrivelse} />
    <meta name="twitter:image" content={ogBilde} />
    <title>{fulltTittel}</title>
    {nivaa && (
      <script is:inline define:vars={{ nokkel: NIVAA_NOKKEL, id: nivaa.id }}>
        try { localStorage.setItem(nokkel, id); } catch { /* ingen lagring */ }
      </script>
    )}
  </head>
  <body>
    <a class="hopp" href="#innhold">Hopp til innhold</a>
    <header class="topp">
      <div class="topp-band"><div class="rad">
        <a class="logo" href={url('')}>Hjelpehefte norsk eksamen</a>
        <nav aria-label="Nivå" class="nivaavalg">
          <ul>
            {NIVAAER.map((n) => (
              <li><a href={nurl(n)} aria-current={n.id === nivaa?.id ? 'true' : undefined}>{n.navn}</a></li>
            ))}
          </ul>
        </nav>
        <div class="topp-verktoy">
          <button type="button" class="topp-knapp" data-modal="om">Om</button>
          <button type="button" class="topp-knapp" data-modal="kilder">Kilder</button>
        </div>
      </div></div>
      {lenker.length > 0 && (
        <div class="rad topp-meny">
          <nav aria-label="Hovedmeny">
            <ul>
              {lenker.map((l) => (
                <li><a href={l.href} aria-current={l.aktiv ? 'page' : undefined}>{l.tekst}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      )}
    </header>
    {visUtkast && (
      <p class="utkastvarsel" role="note">Utkastmodus: øvelser med status «utkast» vises. Den publiserte siden viser bare godkjente øvelser.</p>
    )}
    <main id="innhold" class={`side ${bredde}`} tabindex="-1">
      <slot />
    </main>
    <footer class="bunn">
      <div class="rad">
        <p>© Lærerliv 2026. Hjelpehefte og øvingsside for norsk eksamen.</p>
        <p>Laget av Lærerliv. Finn flere ressurser og tekster om skole på <a href="https://laererliv.no">laererliv.no</a>.</p>
      </div>
    </footer>
    <Modaler />
  </body>
</html>

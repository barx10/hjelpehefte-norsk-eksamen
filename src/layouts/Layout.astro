---
// Skriftene ligger på eget domene, så siden sender ingen forespørsler til andre.
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@fontsource/archivo-narrow/latin-600.css';
import '../styles/global.css';
import { url, nurl } from '../lib/url';
import { visUtkast, hentBesvarelser, hentEksamen } from '../lib/innhold';
import { NIVAAER, NIVAA_NOKKEL, type Nivaa } from '../lib/nivaa';

interface Props {
  tittel: string;
  beskrivelse?: string;
  bredde?: 'smal' | 'bred';
  // Sider uten nivå (forsiden og feilsiden) viser bare nivåvalget i menyen.
  nivaa?: Nivaa;
}
const { tittel, beskrivelse = 'Øv til skriftlig eksamen i norsk med flashkort og flervalg basert på Hjelpehefte norsk eksamen.', bredde = 'smal', nivaa } = Astro.props;
const naa = Astro.url.pathname;
const harTekster = nivaa ? (await hentBesvarelser(nivaa)).length > 0 : false;
const harEksamen = nivaa ? (await hentEksamen(nivaa)).length > 0 : false;
const under = (sti: string) => naa.startsWith(nurl(nivaa!, sti));
const lenker = nivaa
  ? [
      { href: nurl(nivaa), tekst: 'Øv', aktiv: naa === nurl(nivaa) || under('ovelser/') },
      ...(harTekster ? [{ href: nurl(nivaa, 'tekster/'), tekst: 'Modelltekster', aktiv: under('tekster/') }] : []),
      ...(harEksamen ? [{ href: nurl(nivaa, 'eksamen/'), tekst: 'Eksamenstrening', aktiv: under('eksamen/') }] : []),
      { href: nurl(nivaa, 'hefte/'), tekst: 'Hefte', aktiv: under('hefte/') },
      { href: nurl(nivaa, 'mal/'), tekst: 'Kompetansemål', aktiv: under('mal/') },
      { href: nurl(nivaa, 'fremgang/'), tekst: 'Min fremgang', aktiv: under('fremgang/') },
    ]
  : [];
const fulltTittel = tittel === 'Hjelpehefte norsk eksamen' ? tittel : `${tittel} | Hjelpehefte norsk eksamen`;
---
<!doctype html>
<html lang="nb" data-nivaa={nivaa?.id}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={beskrivelse} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{fulltTittel}</title>
    {nivaa && (
      <script is:inline define:vars={{ nokkel: NIVAA_NOKKEL, id: nivaa.id }}>
        try { localStorage.setItem(nokkel, id); } catch { /* ingen lagring */ }
      </script>
    )}
  </head>
  <body>
    <a class="hopp" href="#innhold">Hopp til innhold</a>
    <header class="topp">
      <div class="topp-band"><div class="rad">
        <a class="logo" href={nivaa ? nurl(nivaa) : url('')}>Hjelpehefte norsk eksamen</a>
        <nav aria-label="Nivå" class="nivaavalg">
          <ul>
            {NIVAAER.map((n) => (
              <li><a href={nurl(n)} aria-current={n.id === nivaa?.id ? 'true' : undefined}>{n.navn}</a></li>
            ))}
          </ul>
        </nav>
      </div></div>
      {lenker.length > 0 && (
        <div class="rad topp-meny">
          <nav aria-label="Hovedmeny">
            <ul>
              {lenker.map((l) => (
                <li><a href={l.href} aria-current={l.aktiv ? 'page' : undefined}>{l.tekst}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      )}
    </header>
    {visUtkast && (
      <p class="utkastvarsel" role="note">Utkastmodus: øvelser med status «utkast» vises. Den publiserte siden viser bare godkjente øvelser.</p>
    )}
    <main id="innhold" class={`side ${bredde}`} tabindex="-1">
      <slot />
    </main>
    <footer class="bunn">
      <div class="rad">
        <p>© Lærerliv 2026. Hjelpehefte og øvingsside for norsk eksamen.</p>
        <p><a href="https://github.com/barx10/hjelpehefte-norsk-eksamen">Innhold og kode på GitHub</a></p>
      </div>
    </footer>
  </body>
</html>

---
import { tilJson } from '../lib/innhold';

interface Props {
  ovelser: unknown[];
  tittel: string;
}
const { ovelser, tittel } = Astro.props;
---
<section class="runner" id="runner" aria-label={`Øvelser: ${tittel}`}>
  <p>Laster øvelser ...</p>
  <noscript><p>Øvelsene krever JavaScript. Du kan lese heftet uten.</p></noscript>
</section>
<script type="application/json" id="ovelser-data" set:html={tilJson(ovelser)} />

<script>
  import { les, lagre, oppdater, velgOkt, stokk, antallMestret } from '../lib/fremgang';
  import { stokkForskjellig } from '../lib/tekstverktoy';
  import type { Fremgang } from '../lib/fremgang';

  type Felles = { id: string; kapittel: string; utkast: boolean };
  type Flashkort = Felles & { type: 'flashkort'; forside: string; bakside: string };
  type Flervalg = Felles & { type: 'flervalg'; spm: string; alternativer: string[]; riktig: number; forklaring: string; utdrag: string | null };
  type Komma = Felles & {
    type: 'komma'; ord: string[]; komma: boolean[]; regler: number[]; forklaring: string; fasit: string; utenKomma: string;
  };
  type FinnFeil = Felles & {
    type: 'finnfeil'; ord: string[]; feilIndekser: number[]; feil: string; rettelse: string; rettet: string; forklaring: string; tekst: string;
  };
  type Sortering = Felles & {
    type: 'sortering'; oppdrag: string; kategorier: string[]; elementer: { tekst: string; kategori: number }[]; forklaring: string; fasitTekst: string;
  };
  type Rekkefolge = Felles & { type: 'rekkefolge'; oppdrag: string; elementer: string[]; forklaring: string; fasitTekst: string };
  type Matching = Felles & {
    type: 'matching'; oppdrag: string; par: { venstre: string; hoyre: string }[]; forklaring: string; fasitTekst: string;
  };
  type Marker = Felles & { type: 'marker'; oppdrag: string; ord: string[]; riktig: boolean[]; forklaring: string; fasitTekst: string };
  type Ovelse = Flashkort | Flervalg | Komma | FinnFeil | Sortering | Rekkefolge | Matching | Marker;
  const TYPENAVN: Record<Ovelse['type'], string> = {
    flashkort: 'Flashkort',
    flervalg: 'Flervalg',
    komma: 'Sett komma',
    finnfeil: 'Finn feilen',
    sortering: 'Sorter',
    rekkefolge: 'Rekkefølge',
    matching: 'Koble',
    marker: 'Marker i teksten',
  };
  type Svar = { ovelse: Ovelse; riktig: boolean };

  const OKT_STORRELSE = 10;
  const rot = document.getElementById('runner') as HTMLElement;
  const data: Ovelse[] = JSON.parse(document.getElementById('ovelser-data')!.textContent ?? '[]');
  const visKapittel = new Set(data.map((o) => o.kapittel)).size > 1;

  let fremgang: Fremgang = les();
  let filter: 'alle' | Ovelse['type'] = 'alle';
  let okt: Ovelse[] = [];
  let svar: Svar[] = [];
  let tastHandler: ((e: KeyboardEvent) => void) | null = null;
  let lagringFeilet = false;

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    egenskaper: Record<string, string> = {},
    ...barn: (Node | string)[]
  ): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    for (const [k, v] of Object.entries(egenskaper)) {
      if (k === 'class') e.className = v;
      else e.setAttribute(k, v);
    }
    e.append(...barn);
    return e;
  }

  function vis(...barn: Node[]) {
    tastHandler = null;
    rot.replaceChildren(...barn);
    const overskrift = rot.querySelector<HTMLElement>('h2');
    overskrift?.focus();
  }

  function filtrert(): Ovelse[] {
    return filter === 'alle' ? data : data.filter((o) => o.type === filter);
  }

  function lagreFremgang() {
    if (!lagre(fremgang)) lagringFeilet = true;
  }

  function merker(o: Ovelse): HTMLElement {
    const boks = el('div', { class: 'runner-topp' });
    const venstre = el('span');
    if (visKapittel) venstre.append(el('span', { class: 'merke' }, o.kapittel));
    if (o.utkast) venstre.append(' ', el('span', { class: 'merke utkast' }, 'Utkast, ikke godkjent'));
    boks.append(venstre);
    return boks;
  }

  function visStart() {
    const alle = data.map((o) => o.id);
    const typer = [...new Set(data.map((o) => o.type))];
    const mestret = antallMestret(fremgang, alle);

    const barn: Node[] = [
      el('h2', { tabindex: '-1' }, 'Klar til å øve?'),
      el('p', {}, `${data.length} øvelser i dette temaet. Du har mestret ${mestret}. Hver økt tar for seg ${Math.min(OKT_STORRELSE, data.length)} øvelser, og de du kan minst kommer først.`),
    ];

    if (typer.length > 1) {
      const sett = el('fieldset', { class: 'valgrekke' }, el('legend', {}, 'Velg øvelsestype'));
      const valg: [typeof filter, string][] = [['alle', 'Alle'], ...typer.map((t): [typeof filter, string] => [t, TYPENAVN[t]])];
      for (const [verdi, tekst] of valg) {
        const input = el('input', { type: 'radio', name: 'filter', value: verdi });
        input.checked = filter === verdi;
        input.addEventListener('change', () => { filter = verdi; });
        sett.append(el('label', {}, input, tekst));
      }
      barn.push(sett);
    }

    const start = el('button', { class: 'knapp', type: 'button' }, 'Start økt');
    start.addEventListener('click', startOkt);
    barn.push(el('div', { class: 'knapp-rad' }, start));
    if (!lagre(fremgang)) {
      barn.push(el('p', { class: 'tastehint' }, 'Nettleseren din lar ikke siden lagre fremgang. Du kan fortsatt øve.'));
    }
    vis(...barn);
  }

  function startOkt() {
    const kilde = filtrert();
    const ider = velgOkt(kilde.map((o) => o.id), fremgang, OKT_STORRELSE);
    const perId = new Map(kilde.map((o) => [o.id, o]));
    okt = ider.map((id) => perId.get(id)!).filter(Boolean);
    svar = [];
    visOvelse(0);
  }

  function registrer(o: Ovelse, riktig: boolean) {
    fremgang = oppdater(fremgang, o.id, riktig);
    lagreFremgang();
    svar.push({ ovelse: o, riktig });
  }

  function framdrift(indeks: number): Node[] {
    const p = el('progress', { max: String(okt.length), value: String(indeks), 'aria-label': 'Framdrift i økten' });
    return [el('p', { class: 'runner-topp' }, `Øvelse ${indeks + 1} av ${okt.length}`), p];
  }

  function visOvelse(indeks: number) {
    const o = okt[indeks];
    if (!o) return visResultat();
    if (o.type === 'flashkort') visFlashkort(o, indeks);
    else if (o.type === 'flervalg') visFlervalg(o, indeks);
    else if (o.type === 'komma') visKomma(o, indeks);
    else if (o.type === 'finnfeil') visFinnFeil(o, indeks);
    else if (o.type === 'sortering') visSortering(o, indeks);
    else if (o.type === 'rekkefolge') visRekkefolge(o, indeks);
    else if (o.type === 'matching') visMatching(o, indeks);
    else visMarker(o, indeks);
  }

  function neste(indeks: number) {
    visOvelse(indeks + 1);
  }

  function visFlashkort(o: Flashkort, indeks: number) {
    const sporsmal = el('h2', { class: 'spm', tabindex: '-1' }, o.forside);
    const visSvar = el('button', { class: 'knapp', type: 'button' }, 'Vis svar');
    const handlinger = el('div', { class: 'knapp-rad' }, visSvar);
    const flate = el('div', { 'aria-live': 'polite' });

    visSvar.addEventListener('click', () => {
      flate.append(el('div', { class: 'kort-svar' }, el('span', { class: 'etikett' }, 'Svar'), o.bakside));
      const kunne = el('button', { class: 'knapp', type: 'button' }, 'Jeg kunne den');
      const kunneIkke = el('button', { class: 'knapp sekundar', type: 'button' }, 'Jeg kunne den ikke');
      kunne.addEventListener('click', () => { registrer(o, true); neste(indeks); });
      kunneIkke.addEventListener('click', () => { registrer(o, false); neste(indeks); });
      handlinger.replaceChildren(kunne, kunneIkke);
      kunne.focus();
    });

    vis(...framdrift(indeks), merker(o), sporsmal, flate, handlinger);
    // Etter vis() er fokus på overskriften. Det gir skjermlesere spørsmålet først.
  }

  function visFlervalg(o: Flervalg, indeks: number) {
    const alt = stokk(o.alternativer.map((tekst, i) => ({ tekst, riktig: i === o.riktig })));
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, o.spm);
    const sett = el('fieldset', { class: 'valg' });
    sett.setAttribute('aria-label', 'Svaralternativer');
    const tilbakemelding = el('div', { 'aria-live': 'polite' });
    const knapper: HTMLButtonElement[] = [];
    let besvart = false;

    const velg = (i: number) => {
      if (besvart) return;
      besvart = true;
      const valgt = alt[i]!;
      registrer(o, valgt.riktig);
      knapper.forEach((k, j) => {
        k.disabled = true;
        const a = alt[j]!;
        if (a.riktig) {
          k.classList.add('riktig');
          k.append(el('span', { class: 'status' }, 'Riktig'));
        } else if (j === i) {
          k.classList.add('feil');
          k.append(el('span', { class: 'status' }, 'Feil'));
        }
      });
      tilbakemelding.append(
        el('div', { class: `tilbakemelding ${valgt.riktig ? 'riktig' : 'feil'}` },
          el('strong', {}, valgt.riktig ? 'Riktig.' : 'Ikke helt.'),
          o.forklaring),
      );
      const nesteKnapp = el('button', { class: 'knapp', type: 'button' }, indeks + 1 < okt.length ? 'Neste' : 'Se resultat');
      nesteKnapp.addEventListener('click', () => neste(indeks));
      tilbakemelding.append(el('div', { class: 'knapp-rad' }, nesteKnapp));
      nesteKnapp.focus();
    };

    alt.forEach((a, i) => {
      const k = el('button', { class: 'alt', type: 'button' }, el('span', { class: 'tast', 'aria-hidden': 'true' }, String(i + 1)), el('span', {}, a.tekst));
      k.addEventListener('click', () => velg(i));
      knapper.push(k);
      sett.append(k);
    });

    const utdrag = o.utdrag ? el('blockquote', { class: 'utdrag' }, o.utdrag) : document.createComment('');
    vis(...framdrift(indeks), merker(o), overskrift, utdrag, sett, tilbakemelding, el('p', { class: 'tastehint' }, 'Tips: trykk 1 til ' + alt.length + ' på tastaturet for å svare.'));
    tastHandler = (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const n = Number(e.key);
      if (Number.isInteger(n) && n >= 1 && n <= alt.length) {
        e.preventDefault();
        velg(n - 1);
      }
    };
  }


  function nesteKnapp(indeks: number): HTMLButtonElement {
    const k = el('button', { class: 'knapp', type: 'button' }, indeks + 1 < okt.length ? 'Neste' : 'Se resultat');
    k.addEventListener('click', () => neste(indeks));
    return k;
  }

  function visKomma(o: Komma, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, 'Sett komma der det trengs');
    const hjelp = el('p', {}, 'Trykk på et ord for å sette komma etter det. Trykk igjen for å fjerne. Noen setninger trenger ikke komma.');
    const setning = el('p', { class: 'setning' });
    const valgt = o.ord.map(() => false);
    const knapper: HTMLButtonElement[] = [];
    let ferdig = false;

    o.ord.forEach((ord, i) => {
      if (i === o.ord.length - 1) {
        setning.append(el('span', { class: 'ord-siste' }, ord));
        return;
      }
      const k = el('button', { class: 'ord', type: 'button', 'aria-pressed': 'false', 'aria-label': `${ord}, komma etter ordet` }, ord);
      k.addEventListener('click', () => {
        if (ferdig) return;
        valgt[i] = !valgt[i];
        k.setAttribute('aria-pressed', String(valgt[i]));
      });
      knapper.push(k);
      setning.append(k, ' ');
    });

    const flate = el('div', { 'aria-live': 'polite' });
    const sjekk = el('button', { class: 'knapp', type: 'button' }, 'Sjekk svaret');
    const handlinger = el('div', { class: 'knapp-rad' }, sjekk);

    sjekk.addEventListener('click', () => {
      ferdig = true;
      const feilSteder: string[] = [];
      knapper.forEach((k, i) => {
        k.disabled = true;
        const skalHa = o.komma[i]!;
        if (valgt[i] && skalHa) k.classList.add('rett');
        else if (valgt[i] && !skalHa) { k.classList.add('ekstra'); feilSteder.push(`Ikke komma etter «${o.ord[i]}»`); }
        else if (!valgt[i] && skalHa) { k.classList.add('mangler'); feilSteder.push(`Komma mangler etter «${o.ord[i]}»`); }
      });
      const riktig = feilSteder.length === 0;
      registrer(o, riktig);
      const boks = el('div', { class: `tilbakemelding ${riktig ? 'riktig' : 'feil'}` },
        el('strong', {}, riktig ? 'Riktig.' : 'Ikke helt.'));
      if (!riktig) {
        boks.append(el('span', {}, feilSteder.join('. ') + '.'), el('br'), el('span', {}, `Riktig setning: ${o.fasit}`), el('br'));
      } else if (!o.komma.some(Boolean)) {
        boks.append('Setningen skal ikke ha komma. ');
      }
      boks.append(o.forklaring);
      const neste_ = nesteKnapp(indeks);
      flate.append(boks, el('div', { class: 'knapp-rad' }, neste_));
      handlinger.remove();
      neste_.focus();
    });

    vis(...framdrift(indeks), merker(o), overskrift, hjelp, setning, flate, handlinger);
  }

  function visFinnFeil(o: FinnFeil, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, 'Finn feilen i setningen');
    const hjelp = el('p', {}, 'Trykk på ordet som er feil skrevet eller feil brukt. Det er én feil.');
    const setning = el('p', { class: 'setning' });
    const flate = el('div', { 'aria-live': 'polite' });
    const knapper: HTMLButtonElement[] = [];
    let ferdig = false;

    o.ord.forEach((ord, i) => {
      const k = el('button', { class: 'ord', type: 'button' }, ord);
      k.addEventListener('click', () => {
        if (ferdig) return;
        ferdig = true;
        const riktig = o.feilIndekser.includes(i);
        knapper.forEach((b, j) => {
          b.disabled = true;
          if (o.feilIndekser.includes(j)) b.classList.add('rett');
          else if (j === i) b.classList.add('ekstra');
        });
        registrer(o, riktig);
        const boks = el('div', { class: `tilbakemelding ${riktig ? 'riktig' : 'feil'}` },
          el('strong', {}, riktig ? 'Riktig.' : `Nei, «${ord}» er ikke feil.`),
          el('span', {}, `Feilen er «${o.feil}». Riktig er «${o.rettelse}».`), el('br'),
          el('span', {}, `Riktig setning: ${o.rettet}`), el('br'),
          o.forklaring);
        const neste_ = nesteKnapp(indeks);
        flate.append(boks, el('div', { class: 'knapp-rad' }, neste_));
        neste_.focus();
      });
      knapper.push(k);
      setning.append(k, ' ');
    });

    vis(...framdrift(indeks), merker(o), overskrift, hjelp, setning, flate);
  }

  /** Felles avslutning for oppgaver som sjekkes med en knapp. */
  function sjekkResultat(o: Ovelse, indeks: number, riktig: boolean, linjer: string[], forklaring: string, flate: HTMLElement, handlinger: HTMLElement) {
    registrer(o, riktig);
    const boks = el('div', { class: `tilbakemelding ${riktig ? 'riktig' : 'feil'}` }, el('strong', {}, riktig ? 'Riktig.' : 'Ikke helt.'));
    for (const linje of linjer) boks.append(el('span', {}, linje), el('br'));
    boks.append(forklaring);
    const neste_ = nesteKnapp(indeks);
    flate.append(boks, el('div', { class: 'knapp-rad' }, neste_));
    handlinger.remove();
    neste_.focus();
  }

  function visSortering(o: Sortering, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, o.oppdrag);
    const valg: (number | null)[] = o.elementer.map(() => null);
    const rader: { i: number; sett: HTMLFieldSetElement; inputs: HTMLInputElement[] }[] = [];
    const liste = el('div', { class: 'sorter' });

    for (const i of stokk(o.elementer.map((_, k) => k))) {
      const e = o.elementer[i]!;
      const sett = el('fieldset', { class: 'sorter-rad' }, el('legend', {}, e.tekst));
      const gruppe = el('div', { class: 'piller' });
      const inputs: HTMLInputElement[] = [];
      o.kategorier.forEach((kategori, k) => {
        const id = `s${indeks}-${i}-${k}`;
        const input = el('input', { type: 'radio', name: `s${indeks}-${i}`, id, value: String(k) });
        input.addEventListener('change', () => { valg[i] = k; });
        inputs.push(input);
        gruppe.append(el('label', { class: 'pille', for: id }, input, el('span', {}, kategori)));
      });
      sett.append(gruppe);
      liste.append(sett);
      rader.push({ i, sett, inputs });
    }

    const flate = el('div', { 'aria-live': 'polite' });
    const sjekk = el('button', { class: 'knapp', type: 'button' }, 'Sjekk svaret');
    const handlinger = el('div', { class: 'knapp-rad' }, sjekk);
    sjekk.addEventListener('click', () => {
      let antallFeil = 0;
      for (const { i, sett, inputs } of rader) {
        inputs.forEach((x) => { x.disabled = true; });
        const fasit = o.elementer[i]!.kategori;
        const riktig = valg[i] === fasit;
        if (!riktig) antallFeil++;
        sett.classList.add(riktig ? 'rett' : 'feil');
        sett.append(el('p', { class: 'rad-status' }, riktig ? 'Riktig.' : `Feil. Riktig er: ${o.kategorier[fasit]}.`));
      }
      sjekkResultat(o, indeks, antallFeil === 0, antallFeil ? [`${antallFeil} av ${o.elementer.length} er feil.`] : [], o.forklaring, flate, handlinger);
    });

    vis(...framdrift(indeks), merker(o), overskrift, liste, flate, handlinger);
  }

  function visRekkefolge(o: Rekkefolge, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, o.oppdrag);
    const hjelp = el('p', {}, 'Bruk pilknappene for å flytte elementene til riktig plass.');
    let ordning = stokkForskjellig(o.elementer.map((_, k) => k));
    let ferdig = false;
    const liste = el('ol', { class: 'rekkefolge' });
    const melding = el('p', { class: 'visuelt-skjult', 'aria-live': 'polite' });

    function tegn(fokus?: { pos: number; knapp: 'opp' | 'ned' }) {
      liste.replaceChildren(...ordning.map((idx, pos) => {
        const tekst = o.elementer[idx]!;
        const opp = el('button', { class: 'liten opp', type: 'button', 'aria-label': `Flytt opp: ${tekst}`, title: 'Flytt opp' }, '↑');
        const ned = el('button', { class: 'liten ned', type: 'button', 'aria-label': `Flytt ned: ${tekst}`, title: 'Flytt ned' }, '↓');
        opp.disabled = ferdig || pos === 0;
        ned.disabled = ferdig || pos === ordning.length - 1;
        const flytt = (til: number, knapp: 'opp' | 'ned') => {
          const [x] = ordning.splice(pos, 1);
          ordning.splice(til, 0, x!);
          melding.textContent = `${tekst} står nå på plass ${til + 1} av ${ordning.length}.`;
          tegn({ pos: til, knapp });
        };
        opp.addEventListener('click', () => flytt(pos - 1, 'opp'));
        ned.addEventListener('click', () => flytt(pos + 1, 'ned'));
        const li = el('li', { class: 'rekke-element' }, el('span', { class: 'rekke-tekst' }, tekst), el('span', { class: 'rekke-knapper' }, opp, ned));
        if (ferdig) li.classList.add(idx === pos ? 'rett' : 'feil');
        return li;
      }));
      if (fokus) {
        const m = liste.children[fokus.pos]?.querySelector<HTMLButtonElement>(fokus.knapp === 'opp' ? '.opp' : '.ned');
        (m && !m.disabled ? m : liste.children[fokus.pos]?.querySelector<HTMLButtonElement>('button:not([disabled])'))?.focus();
      }
    }
    tegn();

    const flate = el('div', { 'aria-live': 'polite' });
    const sjekk = el('button', { class: 'knapp', type: 'button' }, 'Sjekk rekkefølgen');
    const handlinger = el('div', { class: 'knapp-rad' }, sjekk);
    sjekk.addEventListener('click', () => {
      ferdig = true;
      const antallFeil = ordning.filter((idx, pos) => idx !== pos).length;
      tegn();
      sjekkResultat(o, indeks, antallFeil === 0, antallFeil ? [`Riktig rekkefølge: ${o.fasitTekst}`] : [], o.forklaring, flate, handlinger);
    });

    vis(...framdrift(indeks), merker(o), overskrift, hjelp, liste, melding, flate, handlinger);
  }

  function visMatching(o: Matching, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, o.oppdrag);
    const alternativer = stokk(o.par.map((p) => p.hoyre));
    const rader = el('div', { class: 'kobling' });
    const velgere: HTMLSelectElement[] = [];
    o.par.forEach((p, i) => {
      const id = `m${indeks}-${i}`;
      const velger = el('select', { id });
      velger.append(el('option', { value: '' }, 'Velg ...'));
      for (const a of alternativer) velger.append(el('option', { value: a }, a));
      velgere.push(velger);
      rader.append(el('div', { class: 'kobling-rad' }, el('label', { for: id }, p.venstre), velger));
    });

    const flate = el('div', { 'aria-live': 'polite' });
    const sjekk = el('button', { class: 'knapp', type: 'button' }, 'Sjekk svaret');
    const handlinger = el('div', { class: 'knapp-rad' }, sjekk);
    sjekk.addEventListener('click', () => {
      let antallFeil = 0;
      velgere.forEach((v, i) => {
        v.disabled = true;
        const riktig = v.value === o.par[i]!.hoyre;
        if (!riktig) antallFeil++;
        const rad = v.parentElement!;
        rad.classList.add(riktig ? 'rett' : 'feil');
        rad.append(el('p', { class: 'rad-status' }, riktig ? 'Riktig.' : `Feil. Riktig er: ${o.par[i]!.hoyre}`));
      });
      sjekkResultat(o, indeks, antallFeil === 0, antallFeil ? [`${antallFeil} av ${o.par.length} er feil.`] : [], o.forklaring, flate, handlinger);
    });

    vis(...framdrift(indeks), merker(o), overskrift, rader, flate, handlinger);
  }

  function visMarker(o: Marker, indeks: number) {
    const overskrift = el('h2', { class: 'spm', tabindex: '-1' }, o.oppdrag);
    const hjelp = el('p', {}, 'Trykk på ordene du vil markere. Trykk igjen for å fjerne markeringen.');
    const setning = el('p', { class: 'setning' });
    const valgt = o.ord.map(() => false);
    const knapper: HTMLButtonElement[] = [];
    o.ord.forEach((ord, i) => {
      const k = el('button', { class: 'ord marker', type: 'button', 'aria-pressed': 'false' }, ord);
      k.addEventListener('click', () => {
        valgt[i] = !valgt[i];
        k.setAttribute('aria-pressed', String(valgt[i]));
      });
      knapper.push(k);
      setning.append(k, ' ');
    });

    const flate = el('div', { 'aria-live': 'polite' });
    const sjekk = el('button', { class: 'knapp', type: 'button' }, 'Sjekk svaret');
    const handlinger = el('div', { class: 'knapp-rad' }, sjekk);
    sjekk.addEventListener('click', () => {
      const mangler: string[] = [];
      const ekstra: string[] = [];
      knapper.forEach((k, i) => {
        k.disabled = true;
        if (valgt[i] && o.riktig[i]) k.classList.add('rett');
        else if (valgt[i]) { k.classList.add('ekstra'); ekstra.push(`«${o.ord[i]}»`); }
        else if (o.riktig[i]) { k.classList.add('mangler'); mangler.push(`«${o.ord[i]}»`); }
      });
      const linjer: string[] = [];
      if (mangler.length) linjer.push(`Du glemte: ${mangler.join(', ')}.`);
      if (ekstra.length) linjer.push(`Disse skulle ikke vært markert: ${ekstra.join(', ')}.`);
      sjekkResultat(o, indeks, linjer.length === 0, linjer, o.forklaring, flate, handlinger);
    });

    vis(...framdrift(indeks), merker(o), overskrift, hjelp, setning, flate, handlinger);
  }

  document.addEventListener('keydown', (e) => tastHandler?.(e));

  function visResultat() {
    const riktige = svar.filter((s) => s.riktig).length;
    const feil = svar.filter((s) => !s.riktig);
    const ider = data.map((o) => o.id);

    const barn: Node[] = [
      el('h2', { tabindex: '-1' }, 'Økten er ferdig'),
      el('p', { class: 'resultat-tall' }, `${riktige} av ${svar.length} riktige`),
      el('p', {}, `Du har nå mestret ${antallMestret(fremgang, ider)} av ${data.length} øvelser i dette temaet.`),
    ];

    if (feil.length > 0) {
      barn.push(el('h3', {}, 'Repeter disse'));
      const liste = el('ul', { class: 'feilliste' });
      for (const { ovelse } of feil) {
        let spm = '';
        let fasit = '';
        if (ovelse.type === 'flashkort') [spm, fasit] = [ovelse.forside, ovelse.bakside];
        else if (ovelse.type === 'flervalg') [spm, fasit] = [ovelse.spm, `${ovelse.alternativer[ovelse.riktig]}. ${ovelse.forklaring}`];
        else if (ovelse.type === 'komma') [spm, fasit] = [`Sett komma: ${ovelse.utenKomma}`, `${ovelse.fasit} ${ovelse.forklaring}`];
        else if (ovelse.type === 'finnfeil') [spm, fasit] = [`Finn feilen: ${ovelse.tekst}`, `${ovelse.rettet} ${ovelse.forklaring}`];
        else [spm, fasit] = [ovelse.oppdrag, `${ovelse.fasitTekst}. ${ovelse.forklaring}`];
        liste.append(el('li', {}, el('strong', {}, spm), el('span', { class: 'svar' }, fasit)));
      }
      barn.push(liste);
    } else {
      barn.push(el('p', {}, 'Ingen feil i denne økten.'));
    }

    const igjen = el('button', { class: 'knapp', type: 'button' }, 'Ny økt');
    igjen.addEventListener('click', startOkt);
    const tilbake = el('button', { class: 'knapp sekundar', type: 'button' }, 'Til start');
    tilbake.addEventListener('click', visStart);
    barn.push(el('div', { class: 'knapp-rad' }, igjen, tilbake));
    if (lagringFeilet) barn.push(el('p', { class: 'tastehint' }, 'Fremgangen ble ikke lagret i denne nettleseren.'));
    vis(...barn);
  }

  if (data.length === 0) {
    rot.replaceChildren(el('p', {}, 'Det er ingen øvelser her ennå.'));
  } else {
    visStart();
    rot.removeAttribute('aria-busy');
  }
</script>

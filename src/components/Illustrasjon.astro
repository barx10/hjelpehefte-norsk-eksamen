      <rect class="i-mork" x="70" y="52" width="130" height="26" rx="8" />
      <rect class="i-mork" x="70" y="66" width="130" height="12" />
      <rect class="i-okerlys" x="86" y="94" width="14" height="14" rx="3" />
      <path class="i-mork-strek" d="M89 101l3 3 6-7" />
      <path class="i-strek" d="M110 101h70" />
      <rect class="i-okerlys" x="86" y="124" width="14" height="14" rx="3" />
      <path class="i-mork-strek" d="M89 131l3 3 6-7" />
      <path class="i-strek" d="M110 131h60" />
      <rect class="i-okerlys" x="86" y="154" width="14" height="14" rx="3" />

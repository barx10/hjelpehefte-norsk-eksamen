---
/**
 * Pyntebilder tegnet for siden. Fargene kommer fra variablene --ill-* i global.css,
 * slik at bildene følger lys og mørk modus. Bildene er pynt og skjules for skjermlesere.
 */
interface Props {
  motiv: 'skrivebord' | 'hefte' | 'ov' | 'eksamen' | 'tekster' | 'ferdig';
  class?: string;
}
const { motiv, class: klasse = '' } = Astro.props;
---
<svg class={`illustrasjon ill-${motiv} ${klasse}`} viewBox="0 0 360 260" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {motiv === 'skrivebord' && (
    <g>
      <path class="i-bg" d="M40 150C30 90 80 40 150 36c60-4 90 18 140 22 40 4 62 40 54 86-8 50-40 70-100 72H86c-30 0-42-30-46-66Z" />
      <rect class="i-strek-fyll" x="20" y="214" width="320" height="6" rx="3" />
      <!-- bøker -->
      <rect class="i-mork" x="34" y="190" width="96" height="24" rx="3" />
      <rect class="i-papir" x="38" y="194" width="88" height="4" rx="2" />
      <rect class="i-oker" x="42" y="168" width="84" height="22" rx="3" />
      <rect class="i-okerlys" x="48" y="175" width="40" height="5" rx="2.5" />
      <rect class="i-lys" x="38" y="148" width="80" height="20" rx="3" transform="rotate(-4 78 158)" />
      <rect class="i-mork" x="46" y="155" width="10" height="9" rx="1" transform="rotate(-4 78 158)" />
      <!-- notatbok -->

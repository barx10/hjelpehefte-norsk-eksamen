      <path class="i-hvit-strek" d="M244 108h50M244 122h36" />
      <path class="i-oker-strek" d="M296 196v14M289 203h14M70 60v10M65 65h10" />
    </g>
  )}
  {motiv === 'ferdig' && (
    <g>
      <path class="i-bg" d="M60 130c0-58 50-96 120-96s120 38 120 96-50 100-120 100S60 188 60 130Z" />
      <path class="i-oker" d="M140 66h80v40c0 26-18 44-40 44s-40-18-40-44z" />
      <path class="i-oker-strek tykk" d="M140 78h-14c0 22 10 32 20 34M220 78h14c0 22-10 32-20 34" />
      <rect class="i-oker" x="172" y="148" width="16" height="22" />
      <rect class="i-mork" x="146" y="170" width="68" height="16" rx="4" />
      <path class="i-papir" d="M180 82l6 12 13 2-9 9 2 13-12-6-12 6 2-13-9-9 13-2z" />
      <path class="i-mork-strek" d="M96 72l8 8M262 70l-8 8M86 150h12M262 150h12" />
      <circle class="i-lys" cx="104" cy="112" r="6" />
      <circle class="i-mork" cx="258" cy="116" r="5" />
      <path class="i-oker-strek" d="M120 200v12M114 206h12M244 196v12M238 202h12" />

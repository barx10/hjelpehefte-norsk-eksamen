      <path class="i-strek" d="M276 86V68M276 86l12 8" />
      <circle class="i-oker" cx="276" cy="86" r="3.5" />
      <!-- gnister -->
      <path class="i-oker-strek" d="M110 70v14M103 77h14M318 140v10M313 145h10" />
    </g>
  )}
  {motiv === 'hefte' && (
    <g>

      <path class="i-oker-strek" d="M155 172h27" />
      <!-- blyant -->
      <g transform="rotate(-38 250 170)">
        <rect class="i-oker" x="200" y="164" width="76" height="12" rx="2" />
        <rect class="i-mork" x="276" y="164" width="12" height="12" rx="2" />
        <path class="i-okerlys" d="M200 164l-16 6 16 6z" />
        <path class="i-strek-fyll" d="M188 168.5l-4 1.5 4 1.5z" />
      </g>
      <!-- kopp -->
      <rect class="i-lys" x="270" y="180" width="34" height="34" rx="5" />
      <path class="i-lys-strek" d="M304 188c12 0 12 18 0 18" />
      <path class="i-dempet-strek" d="M280 172c-4-6 4-8 0-14M292 172c-4-6 4-8 0-14" />
      <!-- klokke -->
